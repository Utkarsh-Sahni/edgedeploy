# EdgeDeploy configuration. Export these for the api/worker (e.g. `set -a; source .env; set +a`)
# and for docker compose. Values marked "local default" can be omitted on your machine.

# --- GitHub OAuth App (required) ---------------------------------------------------------------
# Create one at https://github.com/settings/developers -> OAuth Apps -> New OAuth App:
#   Homepage URL:               http://localhost:3000
#   Authorization callback URL: http://localhost:8080/login/oauth2/code/github
GITHUB_CLIENT_ID= Ov23lijHqp8QT8rf6qZb
GITHUB_CLIENT_SECRET= 2acdaf8997ccb17bb36cf793c7cce0657122ba6e
# Optional; defaults to {api base url}/login/oauth2/code/github. Must match the callback URL above.
GITHUB_REDIRECT_URI=http://localhost:8080/login/oauth2/code/github

# --- Secrets at rest ---------------------------------------------------------------------------
# AES-256 key for GitHub tokens and project environment variables: openssl rand -base64 32
# The api and the worker MUST use the same key (the worker decrypts env vars at deploy time).
# Local default: a dev-only key baked into the `local` profile (used only while this line stays commented out:
# an empty ENCRYPTION_KEY= would override it and the api would refuse to start). REQUIRED in production.
# ENCRYPTION_KEY=

# --- Web <-> API -------------------------------------------------------------------------------
WEB_ORIGIN=http://localhost:3000          # CORS allow-list (comma-separated)
WEB_URL=http://localhost:3000             # where sign-in redirects land
NEXT_PUBLIC_API_URL=http://localhost:8080 # read by apps/web (copy into apps/web/.env.local)
# Production only: parent domain shared by web and api (e.g. edgedeploy.app) so the dashboard can
# read the XSRF cookie, and secure cookies over HTTPS.
COOKIE_DOMAIN=
COOKIE_SECURE=false

# --- Postgres / Redis / Kafka (local defaults) -------------------------------------------------
POSTGRES_USER=edgedeploy
POSTGRES_PASSWORD=edgedeploy
POSTGRES_DB=edgedeploy
DATABASE_URL=jdbc:postgresql://localhost:5432/edgedeploy
REDIS_HOST=localhost
REDIS_PORT=6379
KAFKA_BOOTSTRAP_SERVERS=localhost:9094

# --- Worker / build engine ---------------------------------------------------------------------
# build (default): clone -> verify commit -> detect framework -> docker build -> IMAGE_BUILT.
# acknowledge: only verify + record each deployment request (no git/Docker needed).
WORKER_MODE=build
# Read access for cloning private repositories (fine-grained PAT: Contents read-only). Optional for
# public repositories. Stays inside the worker: never logged, never sent through Kafka.
GITHUB_DEPLOY_TOKEN=
# Max deployments built at once by one worker; each Docker build can use several CPUs and GBs of RAM.
DEPLOYMENT_WORKER_CONCURRENCY=2
DEPLOYMENT_TIMEOUT_SECONDS=1800
DOCKER_BUILD_TIMEOUT_SECONDS=600
GIT_OPERATION_TIMEOUT_SECONDS=120
# Per-deployment workspaces live under here (default: system temp dir + /edgedeploy).
# EDGEDEPLOY_WORKSPACE_DIR=/var/tmp/edgedeploy
IMAGE_PUSH_TIMEOUT_SECONDS=600
DEPLOY_ROLLOUT_TIMEOUT_SECONDS=600
HEALTH_CHECK_TIMEOUT_SECONDS=180
# Empty = build for the host architecture (the ECS task's runtimePlatform follows the image). e.g. linux/amd64
DOCKER_BUILD_PLATFORM=

# --- AWS deployment target (Phase 4) -----------------------------------------------------------
# Full walkthrough, IAM policy, costs and cleanup: docs/aws-setup.md. Values come from the outputs of
# infrastructure/aws/edgedeploy-foundation.yml. None of them is a secret.
# NEVER put AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY here: the worker uses the standard AWS credential
# chain, e.g. AWS_PROFILE pointing at a profile in ~/.aws/config (SSO or an assumed role).
# false (default) = local mode: deployments end at IMAGE_BUILT and nothing touches AWS.
EDGEDEPLOY_AWS_ENABLED=false
# AWS_PROFILE=edgedeploy-worker     # uncomment; an empty AWS_PROFILE breaks the SDK/CLI profile lookup
AWS_REGION=
AWS_ACCOUNT_ID=
AWS_ECR_REPOSITORY_PREFIX=edgedeploy
AWS_ECS_CLUSTER=edgedeploy
AWS_ECS_EXECUTION_ROLE_ARN=
AWS_ECS_TASK_ROLE_ARN=
AWS_ECS_SUBNET_IDS=                 # comma-separated
AWS_ECS_SECURITY_GROUP_ID=
AWS_ECS_ASSIGN_PUBLIC_IP=true
AWS_ECS_CPU=256
AWS_ECS_MEMORY=512
AWS_ECS_DESIRED_COUNT=1
AWS_ECS_CONTAINER_PORT=3000         # Node/Next.js apps; static sites are served on 8080
AWS_ECS_SECRETS_MODE=ssm            # ssm (SecureString parameters) | environment (demo only)
# alb: shared load balancer (~USD 16+/month fixed), stable URL. public-ip: budget mode, no load balancer,
# URL = the task's public IP (changes per deployment). Must match the stack's RoutingMode parameter.
AWS_ROUTING_MODE=alb
AWS_ECS_CAPACITY=fargate            # fargate | fargate-spot (cheaper, interruptible; ARM64 falls back to fargate)
AWS_ALB_ARN=                        # alb mode only
AWS_VPC_ID=                         # alb mode only
AWS_ALB_LISTENER_PORT_START=10000   # one listener port per project: http://<alb-dns>:<port>
AWS_ALB_LISTENER_PORT_END=10049
AWS_LOG_GROUP=/edgedeploy
AWS_LOG_RETENTION_DAYS=7
APP_HEALTH_CHECK_PATH=/
AWS_MAX_ATTEMPTS=5                  # SDK retries for throttling/5xx only
